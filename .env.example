WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/oauth/callback
WEBFLOW_SCOPES=cms:read,cms:write,sites:read,pages:read,pages:write

APP_PUBLIC_URL=http://localhost:3000

# 32+ character secret; AES-256-GCM key for stored OAuth tokens is derived from it
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string-in-production

# Translation provider: "mock" (deterministic, offline) or "http"
TRANSLATION_PROVIDER=mock
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

DB_ADAPTER=sqlite
DATABASE_PATH=./db/localization.sqlite
PORT=3000
